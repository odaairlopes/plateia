{
  "name": "@plateia/notification-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env --import tsx --import ./src/telemetry.ts --watch --watch-preserve-output src/main.ts",
    "start": "node --env-file-if-exists=../../.env --import tsx --import ./src/telemetry.ts src/main.ts",
    "preview:email": "tsx src/email/preview.ts",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@opentelemetry/api": "~1.10.0",
    "@plateia/contracts": "*",
    "@plateia/platform": "*",
    "@react-email/components": "^1.0.12",
    "nodemailer": "^10.6.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0"
  }
}
