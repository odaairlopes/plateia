# Every value below is the development default already baked into the code,
# so the project runs without a .env file. Copy to .env only to override.
# Never commit real credentials.

# --- Infrastructure (docker compose) ---
POSTGRES_USER=plateia
POSTGRES_PASSWORD=plateia
POSTGRES_DB=plateia

# --- Services ---
DATABASE_URL=postgres://plateia:plateia@localhost:5433/plateia
REDIS_URL=redis://localhost:6380
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:5176
LOG_LEVEL=info

CATALOG_PORT=3001
BOOKING_PORT=3002
PAYMENT_PORT=3003
CATALOG_URL=http://localhost:3001

BACKOFFICE_PORT=3005
# Signs organizer sessions. Any 32+ character random string; mandatory in production.
# BACKOFFICE_JWT_SECRET=

NOTIFICATION_PORT=3004
APP_URL=http://localhost:5173

# --- Infrastructure tuning (production values in render.yaml) ---
# DB_POOL_MAX=10
# TRUST_PROXY_HOPS=0
# EVENT_STREAM_MAXLEN=100000

# --- Email ---
# Default: Mailpit from docker compose (captured locally, inbox at http://localhost:8025).
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
MAIL_FROM="Plateia <ingressos@plateia.dev>"
# To deliver for real, point at any SMTP provider and set credentials, e.g. Brevo:
#   SMTP_HOST=smtp-relay.brevo.com
#   SMTP_PORT=587
#   SMTP_USER=<your Brevo SMTP login>
#   SMTP_PASS=<your Brevo SMTP key>
#   MAIL_FROM="Plateia <a sender address verified in Brevo>"
# Anti-abuse caps (0 disables): emails per address per day, and in total per day.
# MAIL_MAX_PER_RECIPIENT_PER_DAY=5
# MAIL_MAX_PER_DAY=250
# MAIL_RECIPIENT_HASH_SECRET=<random string, 16+ characters>
# Never commit real credentials: .env is git-ignored.

# --- Observability (standard OpenTelemetry variables) ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_METRIC_EXPORT_INTERVAL=10000
# OTEL_SDK_DISABLED=true

# --- Web (Vite) ---
VITE_CATALOG_API_URL=http://localhost:3001
VITE_BOOKING_API_URL=http://localhost:3002
VITE_REMOTE_CATALOG_URL=http://localhost:5174
VITE_REMOTE_BOOKING_URL=http://localhost:5175
VITE_REMOTE_ADMIN_URL=http://localhost:5176
VITE_BACKOFFICE_API_URL=http://localhost:3005
