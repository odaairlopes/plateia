# Every value below is the development default already baked into the code,
# so the project runs without a .env file. Copy to .env only to override.
# Never commit real credentials.

# --- Infrastructure (docker compose) ---
POSTGRES_USER=plateia
POSTGRES_PASSWORD=plateia
POSTGRES_DB=plateia

# --- Services ---
DATABASE_URL=postgres://plateia:plateia@localhost:5433/plateia
REDIS_URL=redis://localhost:6380
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175
LOG_LEVEL=info

CATALOG_PORT=3001
BOOKING_PORT=3002
PAYMENT_PORT=3003
CATALOG_URL=http://localhost:3001

# --- Observability (standard OpenTelemetry variables) ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_METRIC_EXPORT_INTERVAL=10000
# OTEL_SDK_DISABLED=true

# --- Web (Vite) ---
VITE_CATALOG_API_URL=http://localhost:3001
VITE_BOOKING_API_URL=http://localhost:3002
VITE_REMOTE_CATALOG_URL=http://localhost:5174
VITE_REMOTE_BOOKING_URL=http://localhost:5175
